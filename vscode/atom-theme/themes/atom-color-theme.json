  "tokenColors": [
    {
      "name": "Comment (@comment)",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8A8D90",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String (@string)",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#87C38A"
      }
    },
    {
      "name": "String escape / special (@string.escape, Special)",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.special"
      ],
      "settings": {
        "foreground": "#96CBFE"
      }
    },
    {
      "name": "Regex / character (@string, Character)",
      "scope": [
        "string.regexp",
        "constant.character"
      ],
      "settings": {
        "foreground": "#87C38A"
      }
    },
    {
      "name": "Number / boolean / constant (@number, @boolean, @constant)",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.boolean.true",
        "constant.language.boolean.false",
        "constant.other",
        "entity.name.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FD5FF1"
      }
    },
    {
      "name": "Builtin constant (@constant.builtin)",
      "scope": [
        "constant.language",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity"
      ],
      "settings": {
        "foreground": "#FD5FF1",
